# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/airtable_connector

# ─── Redis / BullMQ ───────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Airtable OAuth 2.0 ───────────────────────────────────────────────────────
# Register your OAuth app at: https://airtable.com/create/oauth
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
# Must match the redirect URI registered in the Airtable OAuth app settings
AIRTABLE_REDIRECT_URI=http://localhost:3000/auth/airtable/callback
# Space-separated OAuth scopes
AIRTABLE_SCOPES=data.records:read data.records:write schema.bases:read schema.bases:write

# ─── Airtable Scraping (Puppeteer login) ──────────────────────────────────────
# The Airtable account credentials used by Puppeteer to harvest session cookies
AIRTABLE_LOGIN_EMAIL=
AIRTABLE_LOGIN_PASSWORD=
# Airtable base URL for scraping (the web app, not the API)
AIRTABLE_WEB_URL=https://airtable.com

# ─── Token Encryption ─────────────────────────────────────────────────────────
# 32-byte hex secret for AES-256 encryption of stored OAuth tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ─── Pipeline / Cron ──────────────────────────────────────────────────────────
# Maximum number of bases to process per cron run (5-minute interval)
MAX_BASES_PER_RUN=5
# Airtable API rate limit (requests per second per base)
AIRTABLE_RPS=5

# ─── Frontend (Angular) ───────────────────────────────────────────────────────
# These are read at Angular build time via environment.ts
API_BASE_URL=http://localhost:3000
