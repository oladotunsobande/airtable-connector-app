NODE_ENV=development
PORT=3000

# Comma-separated list of allowed frontend origins (first entry is also used for OAuth redirects)
# Add your ngrok URL here when tunnelling, e.g.:
# CORS_ORIGINS=http://localhost:4200,https://your-subdomain.ngrok-free.app
CORS_ORIGINS=http://localhost:4200

MONGO_URI=mongodb://127.0.0.1:27017/airtable_connector

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

AIRTABLE_CLIENT_ID=your_client_id_here
AIRTABLE_CLIENT_SECRET=your_client_secret_here
AIRTABLE_REDIRECT_URI=http://localhost:3000/auth/airtable/callback
AIRTABLE_SCOPES=data.records:read schema.bases:read

AIRTABLE_LOGIN_EMAIL=your_email@example.com
AIRTABLE_LOGIN_PASSWORD=your_password

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_32_byte_hex_key_here
